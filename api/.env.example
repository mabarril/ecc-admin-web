# Servidor HTTP
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco de Dados PostgreSQL 17
DATABASE_URL=postgresql://ecc:ecc_secret_password@localhost:5432/ecc_db
USE_IN_MEMORY_DB=false

# Segurança & JWT
JWT_SECRET=change-me-in-production-ecc-super-secret-jwt-key-2026
